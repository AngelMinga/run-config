{
  "name": "run-configurations",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.5.0",
  "publisher": "angelminga",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AngelMinga/run-config"
  },
  "bugs": {
    "url": "https://github.com/AngelMinga/run-config/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "intellij",
    "webstorm",
    "run configuration",
    "npm",
    "pnpm",
    "yarn",
    "nvm",
    "launch",
    "flutter",
    "dart"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished",
    "onDebugResolve:npm-run",
    "onDebugResolve:flutter-run",
    "onDebugResolve:script-run",
    "onDebugResolve:compound-run"
  ],
  "contributes": {
    "commands": [
      {
        "command": "runConfigurations.run",
        "title": "%command.run%",
        "category": "%category%",
        "icon": "$(play)"
      },
      {
        "command": "runConfigurations.debug",
        "title": "%command.debug%",
        "category": "%category%",
        "icon": "$(debug-alt)"
      },
      {
        "command": "runConfigurations.stop",
        "title": "%command.stop%",
        "category": "%category%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "runConfigurations.select",
        "title": "%command.select%",
        "category": "%category%",
        "icon": "$(run-all)"
      },
      {
        "command": "runConfigurations.edit",
        "title": "%command.edit%",
        "category": "%category%",
        "icon": "$(gear)"
      },
      {
        "command": "runConfigurations.importIntellij",
        "title": "%command.import%",
        "category": "%category%"
      },
      {
        "command": "runConfigurations.refreshRuntimes",
        "title": "%command.refresh%",
        "category": "%category%"
      },
      {
        "command": "runConfigurations.attach",
        "title": "%command.attach%",
        "category": "%category%",
        "icon": "$(plug)"
      },
      {
        "command": "runConfigurations.selectDevice",
        "title": "%command.selectDevice%",
        "category": "%category%",
        "icon": "$(device-mobile)"
      },
      {
        "command": "runConfigurations.services.open",
        "title": "%command.showOutput%",
        "category": "%category%",
        "icon": "$(output)"
      },
      {
        "command": "runConfigurations.services.run",
        "title": "%command.run.short%",
        "category": "%category%",
        "icon": "$(play)"
      },
      {
        "command": "runConfigurations.services.debug",
        "title": "%command.debug.short%",
        "category": "%category%",
        "icon": "$(debug-alt)"
      },
      {
        "command": "runConfigurations.services.stop",
        "title": "%command.stop%",
        "category": "%category%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "runConfigurations.services.edit",
        "title": "%command.editConfig%",
        "category": "%category%",
        "icon": "$(gear)"
      },
      {
        "command": "runConfigurations.stopAll",
        "title": "%command.stopAll%",
        "category": "%category%",
        "icon": "$(stop-circle)"
      },
      {
        "command": "runConfigurations.showRunWindow",
        "title": "%command.showRunWindow%",
        "category": "%category%",
        "icon": "$(output)"
      }
    ],
    "keybindings": [
      {
        "command": "runConfigurations.run",
        "key": "shift+f10",
        "mac": "ctrl+r"
      },
      {
        "command": "runConfigurations.debug",
        "key": "shift+f9",
        "mac": "ctrl+d"
      },
      {
        "command": "runConfigurations.stop",
        "key": "ctrl+f2",
        "mac": "cmd+f2",
        "when": "runConfigurations.running"
      },
      {
        "command": "runConfigurations.select",
        "key": "alt+shift+f10",
        "mac": "ctrl+alt+r"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "runConfigurations.run",
          "group": "1_runConfigurations@1"
        },
        {
          "command": "runConfigurations.debug",
          "group": "1_runConfigurations@2"
        },
        {
          "command": "runConfigurations.edit",
          "group": "1_runConfigurations@3"
        },
        {
          "command": "runConfigurations.attach",
          "group": "1_runConfigurations@2.5",
          "when": "runConfigurations.flutterSelected"
        },
        {
          "command": "runConfigurations.selectDevice",
          "group": "2_flutter@1",
          "when": "runConfigurations.flutter"
        }
      ],
      "commandPalette": [
        {
          "command": "runConfigurations.stop",
          "when": "runConfigurations.running"
        },
        {
          "command": "runConfigurations.services.open",
          "when": "false"
        },
        {
          "command": "runConfigurations.services.run",
          "when": "false"
        },
        {
          "command": "runConfigurations.services.debug",
          "when": "false"
        },
        {
          "command": "runConfigurations.services.stop",
          "when": "false"
        },
        {
          "command": "runConfigurations.services.edit",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "runConfigurations.select",
          "group": "navigation@-10",
          "when": "view == workbench.explorer.fileView"
        },
        {
          "command": "runConfigurations.edit",
          "when": "view == runConfigurations.services",
          "group": "navigation@1"
        },
        {
          "command": "runConfigurations.stopAll",
          "when": "view == runConfigurations.services && runConfigurations.running",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "runConfigurations.services.run",
          "when": "view == runConfigurations.services && viewItem =~ /^config\\.stopped/",
          "group": "inline@1"
        },
        {
          "command": "runConfigurations.services.debug",
          "when": "view == runConfigurations.services && viewItem =~ /^config\\.stopped/",
          "group": "inline@2"
        },
        {
          "command": "runConfigurations.services.run",
          "when": "view == runConfigurations.services && viewItem =~ /^config\\.running/",
          "group": "inline@1"
        },
        {
          "command": "runConfigurations.services.stop",
          "when": "view == runConfigurations.services && viewItem =~ /^config\\.running/",
          "group": "inline@3"
        },
        {
          "command": "runConfigurations.services.run",
          "when": "view == runConfigurations.services && viewItem =~ /^config/",
          "group": "1_run@1"
        },
        {
          "command": "runConfigurations.services.debug",
          "when": "view == runConfigurations.services && viewItem =~ /^config/",
          "group": "1_run@2"
        },
        {
          "command": "runConfigurations.services.stop",
          "when": "view == runConfigurations.services && viewItem =~ /^config\\.running/",
          "group": "1_run@3"
        },
        {
          "command": "runConfigurations.services.open",
          "when": "view == runConfigurations.services && viewItem =~ /^config/",
          "group": "2_view@1"
        },
        {
          "command": "runConfigurations.services.edit",
          "when": "view == runConfigurations.services && viewItem =~ /^config/",
          "group": "2_view@2"
        }
      ]
    },
    "debuggers": [
      {
        "type": "npm-run",
        "label": "%debugger.label%",
        "languages": [
          "javascript",
          "typescript",
          "javascriptreact",
          "typescriptreact"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "packageJson"
            ],
            "properties": {
              "packageJson": {
                "type": "string",
                "description": "%attr.packageJson%",
                "default": "${workspaceFolder}/package.json"
              },
              "command": {
                "type": "string",
                "description": "%attr.command%",
                "default": "run",
                "examples": [
                  "run",
                  "start",
                  "test",
                  "install"
                ]
              },
              "scripts": {
                "type": [
                  "string",
                  "array"
                ],
                "description": "%attr.scripts%"
              },
              "arguments": {
                "type": [
                  "string",
                  "array"
                ],
                "description": "%attr.arguments%"
              },
              "nodeRuntime": {
                "type": "string",
                "description": "%attr.nodeRuntime%"
              },
              "nodeOptions": {
                "type": "string",
                "description": "%attr.nodeOptions%"
              },
              "packageManager": {
                "type": "string",
                "description": "%attr.packageManager%",
                "examples": [
                  "npm",
                  "pnpm",
                  "yarn",
                  "bun"
                ]
              },
              "env": {
                "type": "object",
                "description": "%attr.env%",
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "allowMultipleInstances": {
                "type": "boolean",
                "description": "%attr.allowMultiple%",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "npm-run",
            "request": "launch",
            "name": "npm start",
            "packageJson": "^\"\\${workspaceFolder}/package.json\"",
            "command": "start"
          }
        ],
        "configurationSnippets": [
          {
            "label": "%snippet.label%",
            "description": "%snippet.description%",
            "body": {
              "type": "npm-run",
              "request": "launch",
              "name": "${1:npm run dev}",
              "packageJson": "^\"\\${workspaceFolder}/${2:package.json}\"",
              "command": "${3:run}",
              "scripts": "${4:dev}",
              "packageManager": "${5:pnpm}"
            }
          }
        ]
      },
      {
        "type": "flutter-run",
        "label": "%debugger.flutter.label%",
        "languages": [
          "dart"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "%attr.program%",
                "default": "${workspaceFolder}/lib/main.dart"
              },
              "runArgs": {
                "type": [
                  "string",
                  "array"
                ],
                "description": "%attr.runArgs%"
              },
              "flavor": {
                "type": "string",
                "description": "%attr.flavor%"
              },
              "env": {
                "type": "object",
                "description": "%attr.env%",
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "allowMultipleInstances": {
                "type": "boolean",
                "description": "%attr.allowMultiple%",
                "default": false
              },
              "attachArgs": {
                "type": [
                  "string",
                  "array"
                ],
                "description": "%attr.attachArgs%"
              },
              "deviceId": {
                "type": "string",
                "description": "%attr.deviceId%",
                "examples": [
                  "macos",
                  "chrome",
                  "ios",
                  "emulator-5554"
                ]
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "flutter-run",
            "request": "launch",
            "name": "main.dart",
            "program": "^\"\\${workspaceFolder}/lib/main.dart\""
          }
        ],
        "configurationSnippets": [
          {
            "label": "%snippet.flutter.label%",
            "description": "%snippet.flutter.description%",
            "body": {
              "type": "flutter-run",
              "request": "launch",
              "name": "${1:main.dart}",
              "program": "^\"\\${workspaceFolder}/${2:lib/main.dart}\""
            }
          }
        ]
      },
      {
        "type": "script-run",
        "label": "%debugger.script.label%",
        "languages": [
          "python",
          "shellscript"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "script"
            ],
            "properties": {
              "script": {
                "type": "string",
                "description": "%attr.script%",
                "default": "${workspaceFolder}/script.py"
              },
              "arguments": {
                "type": [
                  "string",
                  "array"
                ],
                "description": "%attr.scriptArguments%"
              },
              "interpreter": {
                "type": "string",
                "description": "%attr.interpreter%",
                "examples": [
                  "python3",
                  "bash",
                  "node",
                  "${workspaceFolder}/venv/bin/python3"
                ]
              },
              "workingDir": {
                "type": "string",
                "description": "%attr.workingDir%"
              },
              "env": {
                "type": "object",
                "description": "%attr.env%",
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "allowMultipleInstances": {
                "type": "boolean",
                "description": "%attr.allowMultiple%",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "script-run",
            "request": "launch",
            "name": "script",
            "script": "^\"\\${workspaceFolder}/script.py\""
          }
        ],
        "configurationSnippets": [
          {
            "label": "%snippet.script.label%",
            "description": "%snippet.script.description%",
            "body": {
              "type": "script-run",
              "request": "launch",
              "name": "${1:script}",
              "script": "^\"\\${workspaceFolder}/${2:script.py}\"",
              "arguments": "$3"
            }
          }
        ]
      },
      {
        "type": "compound-run",
        "label": "%debugger.compound.label%",
        "configurationAttributes": {
          "launch": {
            "required": [
              "configurations"
            ],
            "properties": {
              "configurations": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "%attr.configurations%"
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "%snippet.compound.label%",
            "description": "%snippet.compound.description%",
            "body": {
              "type": "compound-run",
              "request": "launch",
              "name": "${1:All}",
              "configurations": [
                "${2:api}",
                "${3:web}"
              ]
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "%extension.displayName%",
      "properties": {
        "runConfigurations.defaultNodeRuntime": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "%settings.defaultNodeRuntime%"
        },
        "runConfigurations.showStatusBar": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%settings.showStatusBar%"
        },
        "runConfigurations.offerIntellijImport": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%settings.offerIntellijImport%"
        },
        "runConfigurations.floatingDialog": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%settings.floatingDialog%"
        },
        "runConfigurations.npmConsole": {
          "type": "string",
          "enum": [
            "integratedTerminal",
            "internalConsole"
          ],
          "default": "integratedTerminal",
          "enumDescriptions": [
            "%config.npmConsole.terminal%",
            "%config.npmConsole.debugConsole%"
          ],
          "description": "%config.npmConsole%"
        },
        "runConfigurations.runWindow": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%settings.runWindow%"
        }
      }
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "runConfigurations",
          "title": "%container.services%",
          "icon": "media/services.svg"
        }
      ]
    },
    "views": {
      "runConfigurations": [
        {
          "id": "runConfigurations.services",
          "name": "%view.services%",
          "icon": "media/services.svg"
        },
        {
          "id": "runConfigurations.output",
          "name": "%view.run%",
          "type": "webview",
          "icon": "media/services.svg"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsc -p tsconfig.test.json && node --test out/test/*.test.js",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run typecheck && node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.95.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.28.2",
    "jsonc-parser": "^3.3.1",
    "typescript": "^5.9.3"
  }
}
